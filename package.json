{
  "name": "@nexastellar/wallet-kit",
  "version": "0.1.0",
  "description": "TypeScript wallet adapters for Freighter, Albedo, Rabet, and xBull on Stellar",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "stellar",
    "wallet",
    "freighter",
    "albedo",
    "rabet",
    "blockchain",
    "crypto",
    "web3",
    "soroban",
    "typescript"
  ],
  "author": "NexaStellar <hello@nexastellar.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NexaStellar/stellar-wallet-kit.git"
  },
  "bugs": {
    "url": "https://github.com/NexaStellar/stellar-wallet-kit/issues"
  },
  "homepage": "https://github.com/NexaStellar/stellar-wallet-kit#readme",
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@eslint/js": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^10.0.0",
    "prettier": "^3.1.1",
    "tsup": "^8.0.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    }
  }
}
